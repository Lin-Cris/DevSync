{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevSync",
  "version": "0.1.1",
  "identifier": "me.nabdev.iloader",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build && bun scripts/build-agent-sidecar.ts",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DevSync",
        "width": 1388,
        "height": 832,
        "minHeight": 620,
        "minWidth": 980,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "externalBin": ["binaries/devsync-agent"],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
